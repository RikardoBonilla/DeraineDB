{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "esModuleInterop": true,
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false
    },
    "include": ["src/**/*"]
}
